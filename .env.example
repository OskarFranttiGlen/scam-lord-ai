# Supabase (Project Settings → API)
# Shipworthy app reads the REACT_APP_* names; keep both in sync.
NEXT_PUBLIC_REACT_APP_SUPABASE_URL=
NEXT_PUBLIC_REACT_APP_SUPABASE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel AI Gateway (Claude + Jev for voice agent)
AI_GATEWAY_API_KEY=
# When 1/true, Jev flags use hardship/dispute/distress playbooks instead of auto-handoff (scenario doc)
SCAMLORD_PLAYBOOK_MODE=

# LiveKit voice worker
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
# Optional ElevenLabs voice (default: premade "Will")
ELEVEN_VOICE_ID=

# Stripe (test mode). Webhook secret from `stripe listen` locally or the dashboard endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: override demo tenancy JSON for voice calls
# DEMO_CALL_CONTEXT=

# Outbound phone calls (LiveKit SIP → Twilio Elastic SIP Trunking)
# Trunk id printed by `npx tsx scripts/setup-livekit-sip.ts`
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
# Twilio termination domain, e.g. scamlord.pstn.twilio.com
TWILIO_SIP_TRUNK_DOMAIN=
# Twilio credential list entry attached to the trunk's termination
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=

# Payment link messaging: Twilio SMS + Resend email
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 Twilio number: SMS sender and outbound caller id
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=
# Verified Resend sender, e.g. ScamLord AI <rent@yourdomain.com>
RESEND_FROM_EMAIL=

# Optional: live-test recipients (never message arbitrary numbers)
# DEMO_TENANT_PHONE=
# Open Stripe test invoice for the demo tenancy; create one with `npx tsx scripts/seed-stripe-demo.ts`
# DEMO_STRIPE_INVOICE_ID=
# DEMO_TENANT_EMAIL=

# Two-way SMS: public URL Twilio posts inbound texts to (set when a tunnel/proxy rewrites the host),
# e.g. https://<host>/api/sms/inbound. Signature checks use TWILIO_AUTH_TOKEN.
TWILIO_WEBHOOK_URL=

# Inbound callbacks (Twilio Elastic SIP Trunk origination → LiveKit). Ids printed by
# `npx tsx scripts/setup-livekit-inbound.ts`; informational, the worker does not read them.
LIVEKIT_SIP_INBOUND_TRUNK_ID=
LIVEKIT_SIP_DISPATCH_RULE_ID=
# Optional comma-separated source IPs/CIDRs allowed on the inbound trunk (Twilio signalling ranges)
LIVEKIT_SIP_INBOUND_ALLOWED_ADDRESSES=
# Dev only: trust a non-SIP participant's sip.phoneNumber attribute (scripts/callback-smoke.ts)
# VOICE_DEV_FAKE_SIP_CALLERS=1
